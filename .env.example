# ============================================================
# INTELLIGENT WORKSPACE — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=workspace_db

# Backend Configuration
SECRET_KEY=generate_a_random_32_character_secret_key_here
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://yourdomain.com
